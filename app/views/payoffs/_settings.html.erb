<div data-controller="dialog-opener">
  <%= render DS::Button.new(text: t("payoffs.settings.open"), icon: "settings", variant: :outline, size: :sm,
    data: { action: "dialog-opener#open" }) %>
  <%= render DS::Dialog.new(id: "payoff-settings", auto_open: false, disable_frame: true, width: "lg") do |dialog| %>
    <% dialog.with_header(title: t("payoffs.settings.title"), subtitle: t("payoffs.settings.subtitle")) %>
    <% dialog.with_body do %>
      <div class="space-y-6">
        <div class="grid grid-cols-2 gap-3">
          <% @alternatives.each do |strategy, projection| %>
            <div class="rounded-lg bg-surface-inset p-3">
              <p class="text-xs text-secondary"><%= t("payoffs.settings.#{strategy}") %></p>
              <p class="text-sm font-medium text-primary"><%= projection.debt_free_month ? payoff_month_date(projection.debt_free_month) : t("payoffs.show.date_pending") %></p>
              <p class="text-xs text-subdued"><%= t("payoffs.settings.estimated_interest", amount: payoff_money(projection.total_interest)) %></p>
            </div>
          <% end %>
        </div>
        <%= form_with model: @plan, url: settings_payoff_path, method: :patch, class: "space-y-4" do |f| %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="form-field"><%= f.label :strategy, t("payoffs.settings.strategy"), class: "form-field__label" %><%= f.select :strategy, [[t("payoffs.settings.snowball"), "snowball"], [t("payoffs.settings.avalanche"), "avalanche"]], {}, class: "form-field__input" %></div>
            <div class="form-field"><%= f.label :high_interest_line, t("payoffs.settings.high_interest_line"), class: "form-field__label" %><%= f.number_field :high_interest_line, step: 0.0001, min: 0, max: 1, class: "form-field__input" %></div>
            <div class="form-field"><%= f.label :monthly_surplus, t("payoffs.settings.monthly_surplus"), class: "form-field__label" %><%= f.number_field :monthly_surplus, step: 0.01, class: "form-field__input" %></div>
            <div class="form-field"><%= f.label :emergency_fund_goal_id, t("payoffs.settings.emergency_goal"), class: "form-field__label" %><%= f.select :emergency_fund_goal_id, options_from_collection_for_select(@goals, :id, :name, @plan.emergency_fund_goal_id), { include_blank: t("payoffs.settings.none") }, class: "form-field__input" %></div>
            <div class="form-field"><%= f.label :payday_anchor_on, t("payoffs.settings.payday_anchor"), class: "form-field__label" %><%= f.date_field :payday_anchor_on, class: "form-field__input" %></div>
            <div class="form-field"><%= f.label :payday_cadence, t("payoffs.settings.payday_cadence"), class: "form-field__label" %><%= f.select :payday_cadence, %w[weekly biweekly semimonthly monthly].map { |c| [t("payoffs.settings.#{c}"), c] }, {}, class: "form-field__input" %></div>
            <div class="form-field"><%= f.label :cash_float, t("payoffs.settings.cash_float"), class: "form-field__label" %><%= f.number_field :cash_float, step: 0.01, min: 0, class: "form-field__input" %></div>
          </div>
          <div class="form-field"><%= f.label :surplus_steps_text, t("payoffs.settings.surplus_steps"), class: "form-field__label" %><%= f.text_area :surplus_steps_text, value: @plan.surplus_steps.map { |step| [step["from"], step["delta"], step["label"]].join(",") }.join("\n"), rows: 3, class: "form-field__input" %><p class="text-xs text-secondary mt-1"><%= t("payoffs.settings.surplus_steps_hint") %></p></div>
          <fieldset><legend class="text-sm font-medium text-primary mb-2"><%= t("payoffs.settings.cash_accounts") %></legend>
            <% @cash_accounts.each do |account| %><label class="flex items-center gap-2 text-sm text-secondary py-1"><%= check_box_tag "debt_plan[cash_account_ids][]", account.id, @plan.cash_account_ids.include?(account.id) %><%= account.name %></label><% end %>
            <%= hidden_field_tag "debt_plan[cash_account_ids][]", "" %>
          </fieldset>
          <div class="flex flex-wrap gap-4"><label class="text-sm text-secondary"><%= f.check_box :email_notifications_enabled %> <%= t("payoffs.settings.email_notifications") %></label><label class="text-sm text-secondary"><%= f.check_box :discord_notifications_enabled %> <%= t("payoffs.settings.discord_notifications") %></label></div>
          <div class="form-field"><%= f.label :discord_webhook_url, t("payoffs.settings.discord_webhook"), class: "form-field__label" %><%= f.url_field :discord_webhook_url, class: "form-field__input", autocomplete: "off" %></div>
          <%= render DS::Button.new(text: t("payoffs.settings.save"), type: :submit, variant: :primary) %>
        <% end %>
        <% if @plan.discord_notifications_enabled? && @plan.discord_webhook_url.present? %>
          <%= button_to t("payoffs.settings.test_discord"), test_discord_payoff_path, method: :post, class: "text-sm text-link underline" %>
        <% end %>

        <%= render DS::Disclosure.new(title: t("payoffs.settings.debts")) do %>
          <% @entries.each do |entry| %>
            <%= form_with model: entry, url: payoff_entry_path(entry), method: :patch, class: "py-3 border-b border-divider space-y-2" do |f| %>
              <h3 class="text-sm font-medium text-primary"><%= entry.account.name %></h3>
              <div class="grid grid-cols-2 gap-2">
                <div class="form-field"><%= f.label :role, t("payoffs.settings.role"), class: "form-field__label" %><%= f.select :role, %w[snowball minimum_only scheduled excluded].map { |role| [t("payoffs.show.roles.#{role}"), role] }, {}, class: "form-field__input" %></div>
                <div class="form-field"><%= f.label :priority, t("payoffs.settings.priority"), class: "form-field__label" %><%= f.number_field :priority, min: 1, class: "form-field__input" %></div>
                <div class="form-field"><%= f.label :minimum_payment_override, t("payoffs.settings.minimum"), class: "form-field__label" %><%= f.number_field :minimum_payment_override, step: 0.01, min: 0, class: "form-field__input" %></div>
                <div class="form-field"><%= f.label :payment_due_day, t("payoffs.settings.due_day"), class: "form-field__label" %><%= f.number_field :payment_due_day, min: 1, max: 31, class: "form-field__input" %></div>
                <div class="form-field"><%= f.label :scheduled_amount, t("payoffs.settings.scheduled_amount"), class: "form-field__label" %><%= f.number_field :scheduled_amount, step: 0.01, min: 0, class: "form-field__input" %></div>
              </div>
              <label class="text-sm text-secondary"><%= f.check_box :frozen_card %> <%= t("payoffs.settings.frozen_card") %></label>
              <div><%= render DS::Button.new(text: t("payoffs.settings.save_debt"), type: :submit, variant: :secondary, size: :sm) %></div>
            <% end %>
          <% end %>
          <% if @available_accounts.any? %>
            <%= form_with url: payoff_entries_path, method: :post, class: "flex flex-wrap gap-2 mt-3" do %>
              <%= select_tag :account_id, options_from_collection_for_select(@available_accounts, :id, :name), class: "form-field__input", aria: { label: t("payoffs.settings.add_debt") } %>
              <%= render DS::Button.new(text: t("payoffs.settings.add_debt"), type: :submit, variant: :secondary, size: :sm) %>
            <% end %>
          <% end %>
        <% end %>

        <%= render DS::Disclosure.new(title: t("payoffs.settings.lump_sums")) do %>
          <% @plan.debt_plan_lump_sums.order(:expected_on).each do |lump| %>
            <div class="py-3 border-b border-divider">
              <%= form_with model: lump, url: payoff_lump_sum_path(lump), method: :patch, class: "grid grid-cols-2 gap-2" do |f| %>
                <div class="form-field"><%= f.label :expected_on, t("payoffs.settings.expected_on"), class: "form-field__label" %><%= f.date_field :expected_on, required: true, class: "form-field__input" %></div>
                <div class="form-field"><%= f.label :amount, t("payoffs.settings.amount"), class: "form-field__label" %><%= f.number_field :amount, step: 0.01, min: 0.01, required: true, class: "form-field__input" %></div>
                <div class="form-field"><%= f.label :label, t("payoffs.settings.label"), class: "form-field__label" %><%= f.text_field :label, required: true, class: "form-field__input" %></div>
                <div class="form-field"><%= f.label :received_on, t("payoffs.settings.received_on"), class: "form-field__label" %><%= f.date_field :received_on, class: "form-field__input" %></div>
                <label class="text-sm text-secondary"><%= f.check_box :scheduled_payments %> <%= t("payoffs.settings.scheduled_payments") %></label>
                <%= render DS::Button.new(text: t("payoffs.settings.save_lump"), type: :submit, variant: :secondary, size: :sm) %>
              <% end %>
              <%= button_to t("payoffs.settings.remove"), payoff_lump_sum_path(lump), method: :delete, class: "text-sm text-link underline mt-2" %>
            </div>
          <% end %>
          <%= form_with model: DebtPlanLumpSum.new, url: payoff_lump_sums_path, method: :post, class: "grid grid-cols-2 gap-2 mt-3" do |f| %>
            <div class="form-field"><%= f.label :expected_on, t("payoffs.settings.expected_on"), class: "form-field__label" %><%= f.date_field :expected_on, required: true, class: "form-field__input" %></div>
            <div class="form-field"><%= f.label :amount, t("payoffs.settings.amount"), class: "form-field__label" %><%= f.number_field :amount, step: 0.01, min: 0.01, required: true, class: "form-field__input" %></div>
            <div class="form-field"><%= f.label :label, t("payoffs.settings.label"), class: "form-field__label" %><%= f.text_field :label, required: true, class: "form-field__input" %></div>
            <label class="text-sm text-secondary self-end"><%= f.check_box :scheduled_payments %> <%= t("payoffs.settings.scheduled_payments") %></label>
            <%= render DS::Button.new(text: t("payoffs.settings.add_lump"), type: :submit, variant: :secondary, size: :sm) %>
          <% end %>
        <% end %>
        <%= button_to t("payoffs.settings.rebaseline"), baseline_payoff_path, method: :post, class: "text-sm text-link underline" %>
      </div>
    <% end %>
  <% end %>
</div>
